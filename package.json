              <button class="settings-nav-item active">General Configuration</button>
              <button class="settings-nav-item" onclick="showToast('Profile management updated.', 'success')">User Profile</button>
              <button class="settings-nav-item" onclick="showToast('Database syncing active.', 'info')">Connected Services</button>
            </div>
            <div class="settings-content">
              <h3 class="settings-section-title">App Configuration</h3>
