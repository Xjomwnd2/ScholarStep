    </main>
  </div>

  <div class="modal-overlay hidden" id="item-modal">
    <div class="modal">
      <div class="modal-header">
        <h3 class="modal-title">Create Backlog Deliverable</h3>
        <button class="modal-close" onclick="closeModal()">✕</button>
      </div>
      <div class="modal-body">
        <div class="modal-form-group">
          <label>Deliverable Title</label>
          <input type="text" placeholder="e.g., Final Presentation Deck" id="modal-title-input" />
        </div>
        <div class="modal-form-group">
          <label>Course Track</label>
          <select>
            <option>Advanced Software Engineering</option>
            <option>Database Systems & Optimization</option>
            <option>Human Computer Interaction</option>
          </select>
        </div>
        <div class="form-row-2">
          <div class="modal-form-group">
            <label>Priority Tier</label>
            <select id="modal-priority-input">
              <option value="high">High Tier</option>
              <option value="medium" selected>Medium Tier</option>
              <option value="low">Low Tier</option>
            </select>
          </div>
          <div class="modal-form-group">
            <label>Target Execution Date</label>
            <input type="date" value="2026-06-15" />
          </div>
        </div>
      </div>
      <div class="modal-footer">
        <button class="btn-sec" onclick="closeModal()">Cancel</button>
        <button class="btn-submit" onclick="submitModalItem()">Append to Backlog</button>
      </div>
    </div>
